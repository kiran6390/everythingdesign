{
  "expo": {
    "name": "Forma",
    "slug": "forma",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "forma",
    "ios": { "supportsTablet": false },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#0D0D0D", "resizeMode": "contain" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
